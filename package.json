{
  "name": "@iggy-lakic/pi-muninndb",
  "version": "1.0.0",
  "description": "MuninnDB MCP plugin for Pi and OMP — one package, works equally on both hosts; registers the MCP server and notifies when MuninnDB is down. Never installs anything.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "omp-plugin",
    "muninndb",
    "mcp",
    "memory"
  ],
  "type": "module",
  "repository": {
    "url": "https://github.com/igorlakic/pi-muninndb",
    "type": "git"
  },
  "homepage": "https://github.com/scrypster/muninndb",
  "maintainers": [
    {
      "name": "Igor Lakić"
    }
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test tests/extension.test.ts",
    "check": "tsc --noEmit --project tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@oh-my-pi/pi-coding-agent": ">=18",
    "pi-mcp-adapter": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "pi-mcp-adapter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    ".mcp.json",
    "src/",
    "tests/",
    "README.md",
    "LICENSE",
    "package.json",
    "tsconfig.json"
  ],
  "dependencies": {
    "@types/node": "^26.6.5"
  }
}
